APP_NAME=S-MAP AI Server
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Spring internal Evidence API
EVIDENCE_LOOKUP_ENABLED=false
EVIDENCE_LOOKUP_BASE_URL=http://localhost:8080
EVIDENCE_LOOKUP_PATH=/internal/chat/evidence
EVIDENCE_LOOKUP_INTERNAL_TOKEN=
EVIDENCE_LOOKUP_TIMEOUT_SECONDS=10.0

# Qdrant document search
QDRANT_SEARCH_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smap_internal_documents
QDRANT_TOP_K=5
QDRANT_TIMEOUT_SECONDS=10.0

# Qdrant document indexing
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=80
DOCUMENT_INDEX_INTERNAL_TOKEN=

# Query embedding
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30.0

# Grounded answer generation
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=local-open-source-model
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60.0
