APP_NAME=S-MAP AI Server
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Spring internal Chat API
CHAT_ANSWER_INTERNAL_TOKEN=
CHAT_RECOMMENDATION_INTERNAL_TOKEN=

# Spring internal Evidence API
EVIDENCE_LOOKUP_ENABLED=false
EVIDENCE_LOOKUP_BASE_URL=http://localhost:8080
EVIDENCE_LOOKUP_PATH=/internal/chat/evidence
EVIDENCE_LOOKUP_INTERNAL_TOKEN=
EVIDENCE_LOOKUP_TIMEOUT_SECONDS=10.0

# RDB read-only evidence views
RDB_EVIDENCE_ENABLED=false
RDB_EVIDENCE_DSN=
RDB_EVIDENCE_TIMEOUT_SECONDS=5.0
RDB_EVIDENCE_MAX_LIMIT=20

# Report RDB
REPORT_RDB_ENABLED=true
REPORT_RDB_DSN=
REPORT_RDB_TIMEOUT_SECONDS=5.0
PLANNING_RDB_TIMEOUT_SECONDS=5.0

# Qdrant document search
QDRANT_SEARCH_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smap_internal_documents
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.0
QDRANT_TIMEOUT_SECONDS=10.0

# Qdrant document indexing
DOCUMENT_CONTENT_MAX_CHARS=100000
DOCUMENT_MAX_CHUNKS=200
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=80
DOCUMENT_INDEX_INTERNAL_TOKEN=

# Query embedding
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=huggingface
EMBEDDING_BASE_URL=http://localhost:8002
EMBEDDING_PATH=/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30.0

# Grounded answer generation
LLM_ENABLED=false
# OpenAI 사용 시: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.openai.com/v1
# 로컬/사내 OpenAI-compatible 서버 사용 시: LLM_PROVIDER=openai_compatible
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# OpenAI 사용 시 LLM_API_KEY 또는 표준 OPENAI_API_KEY 중 하나를 Secret/env로 주입한다.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
# OpenAI provider는 LLM_MODEL이 이 목록 안에 있을 때만 호출한다. 쉼표로 여러 모델 지정 가능.
# 운영 기본 추천값은 비용 절감을 위해 LLM_MODEL=gpt-5-nano,
# LLM_ALLOWED_MODELS=gpt-5-nano 조합을 사용한다.
LLM_ALLOWED_MODELS=
# GPT-5/o-series 계열은 reasoning token 비용을 줄이기 위해 minimal을 기본으로 사용한다.
LLM_REASONING_EFFORT=minimal
LLM_TEMPERATURE=0.1
# OpenAI provider는 비용 보호를 위해 1024 이하를 권장/검증한다.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0
# OpenAI provider는 반복 호출 비용을 줄이기 위해 캐시가 켜져 있어야 한다.
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=60.0
LLM_RESPONSE_CACHE_MAX_ENTRIES=128
ANSWER_MAX_CHARS=900

# Prompt budget
PROMPT_MAX_EVIDENCE_ITEMS=3
PROMPT_MAX_DOCUMENT_SOURCES=2
PROMPT_MAX_SUMMARY_CHARS=280
# OpenAI provider는 비용 보호를 위해 3000자 이하를 운영 기본값으로 사용한다.
PROMPT_MAX_TOTAL_CHARS=3000

# Report RDB evidence 
REPORT_RDB_DSN=YOUR_DB

# Business report LLM
BUSINESS_REPORT_LLM_ENABLED=false
