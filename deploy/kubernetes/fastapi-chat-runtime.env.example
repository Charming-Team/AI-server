# FastAPI chatbot runtime settings for Kubernetes.
# Secret values must be injected from Kubernetes Secret, not committed here.

APP_NAME=S-MAP AI Server
ENVIRONMENT=kubernetes
API_V1_PREFIX=/ai/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CHAT_ANSWER_INTERNAL_TOKEN=__SET_BY_SECRET__
CHAT_RECOMMENDATION_INTERNAL_TOKEN=__SET_BY_SECRET__
DOCUMENT_INDEX_INTERNAL_TOKEN=__SET_BY_SECRET__

EVIDENCE_LOOKUP_ENABLED=false
EVIDENCE_LOOKUP_BASE_URL=http://localhost:8080
EVIDENCE_LOOKUP_PATH=/internal/chat/evidence
EVIDENCE_LOOKUP_INTERNAL_TOKEN=
EVIDENCE_LOOKUP_TIMEOUT_SECONDS=10.0

RDB_EVIDENCE_ENABLED=true
RDB_EVIDENCE_DSN=__SET_BY_SECRET__
RDB_EVIDENCE_TIMEOUT_SECONDS=5.0
RDB_EVIDENCE_MAX_LIMIT=20

QDRANT_SEARCH_ENABLED=true
QDRANT_URL=http://qdrant.qdrant.svc.cluster.local:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smap_internal_documents
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.0
QDRANT_TIMEOUT_SECONDS=10.0

EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=huggingface
EMBEDDING_BASE_URL=http://embedding-service.skala3-finalproj-class3-team12.svc.cluster.local:8002
EMBEDDING_PATH=/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60.0

LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=__SET_BY_SECRET__
LLM_MODEL=__SET_OPENAI_MODEL__
LLM_ALLOWED_MODELS=__SET_OPENAI_ALLOWED_MODELS__
LLM_REASONING_EFFORT=minimal
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60.0
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=60.0
LLM_RESPONSE_CACHE_MAX_ENTRIES=128

ANSWER_MAX_CHARS=2000
PROMPT_MAX_EVIDENCE_ITEMS=5
PROMPT_MAX_DOCUMENT_SOURCES=5
PROMPT_MAX_SUMMARY_CHARS=700
PROMPT_MAX_DATA_CHARS=1000
PROMPT_MAX_TOTAL_CHARS=6000
